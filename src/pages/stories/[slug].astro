---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { dogs } from '../../data/dogs';
import { categories } from '../../data/taxonomy';
import { publishedStories, relatedStories } from '../../lib/stories';
import { asset } from '../../utils/paths';
import { render } from 'astro:content';
export async function getStaticPaths() { return (await publishedStories()).map((story) => ({ params: { slug: story.data.slug }, props: { story } })); }
const { story } = Astro.props;
const { Content } = await render(story);
const allStories = await publishedStories();
const related = relatedStories(story, allStories);
const socials = Object.entries(story.data.socialLinks).filter(([, url]) => Boolean(url));
---
<BaseLayout title={`${story.data.title} — BulldogsManila`} description={story.data.excerpt} image={story.data.socialImage ?? story.data.heroImage} imageAlt={story.data.heroAlt} articleDate={story.data.date}>
  <article class="story-page">
    <header class="story-header wrap"><p class="eyebrow">{categories[story.data.category]} · {story.data.date.toLocaleDateString('en-PH', { dateStyle: 'long' })}</p><h1>{story.data.title}</h1><p class="lede">{story.data.excerpt}</p><p class="byline">A story with {story.data.dogs.map((slug) => dogs[slug].name).join(' & ')}</p></header>
    <div class="story-hero wrap"><img src={asset(story.data.heroImage)} alt={story.data.heroAlt} width="1400" height="933" fetchpriority="high" /></div>
    <div class="prose"><Content /></div>
    <footer class="story-footer wrap"><div class="tags">{story.data.feelings.map((feeling) => <a href={asset(`/feelings/${feeling}/`)}>I need {feeling}</a>)}</div>{socials.length > 0 && <div class="socials"><span>Elsewhere:</span>{socials.map(([network, url]) => <a href={url as string} rel="external">{network}</a>)}</div>}</footer>
  </article>
  {related.length > 0 && <section class="section wrap"><header class="section-heading"><div><p class="eyebrow">Keep reading</p><h2>More from the pack</h2></div></header><div class="story-grid">{related.map((item) => <StoryCard story={item} />)}</div></section>}
</BaseLayout>
